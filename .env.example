# Salin file ini menjadi .env lalu isi nilainya. Jangan commit file .env.

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bimbel_db
DB_USER=bimbel_user
DB_PASSWORD=ganti_dengan_password_kuat

# OTP: "simulasi" (kode tampil di terminal) atau "email" (kirim lewat SMTP)
OTP_MODE=simulasi
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=3

# Keamanan login
MAX_LOGIN_ATTEMPTS=3
LOCK_MINUTES=5

# Email (dipakai jika OTP_MODE=email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Gemini (opsional)
GEMINI_API_KEY=
