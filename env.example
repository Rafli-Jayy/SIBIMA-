# ============================================================
# SIBIMA EAI - CONTOH KONFIGURASI (bukan kredensial asli)
# ============================================================
# Salin ke .env pada root proyek lalu ubah nilai yang diperlukan.
# JANGAN commit, unggah, atau kirim file .env yang berisi rahasia.
# Pilih 'local' atau 'supabase'. Hanya target terpilih yang dipakai.

# ------------------------------------------------------------
# 1. DATABASE POSTGRESQL
# ------------------------------------------------------------
DB_TARGET=local

# Database lokal (dipakai jika DB_TARGET=local)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bimbel_db
DB_USER=bimbel_user
DB_PASSWORD=ganti_dengan_password_database_lokal
DB_SSLMODE=prefer

# Supabase (isi dulu jika akan mengubah DB_TARGET=supabase)
# Host/port/username harus sesuai detail koneksi proyek Supabase.
# Jangan gunakan placeholder berikut untuk koneksi nyata.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_SSLMODE=require

# ------------------------------------------------------------
# 2. OTP DAN LOGIN
# ------------------------------------------------------------
# OTP_MODE: simulasi atau email
OTP_MODE=simulasi
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=3
MAX_LOGIN_ATTEMPTS=3
LOCK_MINUTES=5

# ------------------------------------------------------------
# 3. SIMULASI PEMBAYARAN
# ------------------------------------------------------------
# Rentang 0 sampai 100; 90 berarti simulasi berhasil 90% peluang.
PAYMENT_SIMULATION_SUCCESS_RATE=90

# ------------------------------------------------------------
# 4. EMAIL / SMTP
# ------------------------------------------------------------
# Dibutuhkan untuk OTP_MODE=email dan pengiriman email lainnya.
# Jika memakai Gmail, biasanya perlu App Password yang sah.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ------------------------------------------------------------
# 5. SIBIMA-AI / GEMINI
# ------------------------------------------------------------
# Isi API key di .env saja. Tanpa key, Tanya AI online tidak berjalan.
GEMINI_API_KEY=

# Model ini dipilih berdasarkan model yang sebelumnya berhasil diuji.
# Ganti jika tidak tersedia pada akun/API key yang digunakan.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=low

# GEMINI_MAX_ATTEMPTS: 1-3 (1 = tanpa retry oleh adapter SIBIMA)
GEMINI_MAX_ATTEMPTS=1
# GEMINI_TIMEOUT_SECONDS: 10-300 detik
GEMINI_TIMEOUT_SECONDS=35

# Google Search grounding dimatikan secara default (opt-in).
GEMINI_GOOGLE_SEARCH_ENABLED=false

# ------------------------------------------------------------
# 6. LOCAL KNOWLEDGE RAG (opsional)
# ------------------------------------------------------------
# Aktifkan hanya setelah sumber knowledge/indeks tervalidasi.
# RAG saat ini membutuhkan tools/verify_sibima_knowledge.py;
# skrip tersebut tidak ada pada ZIP yang diperiksa.
SIBIMA_RAG_ENABLED=false
SIBIMA_RAG_SOURCE_ROOT=knowledge/verified
SIBIMA_RAG_INDEX_DIR=knowledge/index_verified
